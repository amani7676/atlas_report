    <!-- دکمه همگام‌سازی -->
    <button 
        wire:click="syncResidents" 
        wire:loading.attr="disabled"
        class="btn {{ ($resetData ?? false) ? 'btn-danger' : 'btn-primary' }}"
        style="display: flex; align-items: center; gap: 8px;"
        @if(($syncing ?? false)) disabled @endif
    >
        <i class="fas fa-sync-alt" wire:loading.class="fa-spin"></i>
        <span wire:loading.remove>
            {{ ($resetData ?? false) ? 'بازنشانی و همگام‌سازی' : 'همگام‌سازی اطلاعات' }}
        </span>
        <span wire:loading>در حال همگام‌سازی...</span>
    </button>
    
